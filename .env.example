# Пример переменных окружения проекта. Скопируйте этот файл в .env
# и заполните настоящими значениями — файл .env в Git не попадает
# (см. .gitignore). На реальном хостинге (например, Render) эти же
# переменные задаются в его собственной панели Environment, а не
# через файл .env вообще.

# ---- Общие настройки Flask ----
# Секретный ключ сессий сайта. Сгенерировать можно, например:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-real-random-value

# ---- Карта филиалов (Yandex Maps) ----
# Ключ JS API Яндекс.Карт (developer.tech.yandex.ru), не обязателен —
# без него сайт покажет текстовую заглушку вместо карты.
YANDEX_MAPS_API_KEY=

# ---- Интеграция с 1С:Фитнес клуб (только для филиала "мкр. Бабаевского") ----
# Подробности см. integrations/fitness1c/config.py и README по
# первому подключению ниже. НИКОГДА не ставьте сюда настоящие
# логин/пароль в этом .env.example файле — он версионируется в Git.

# "1" чтобы включить реальные вызовы к 1С. Пока не "1" — вся интеграция
# работает в режиме-заглушке и честно сообщает, что не настроена, ни
# один HTTP-запрос к 1С при этом не выполняется.
FITNESS1C_ENABLED=0

# Адрес API 1С для вашего конкретного клуба — его выдаёт поддержка
# 1С:Фитнес клуб при подключении интеграции вместе с логином/паролем.
# Пример формата (НЕ настоящий адрес, нужно заменить):
# FITNESS1C_BASE_URL=https://club1234.fitness1c.ru/api3
FITNESS1C_BASE_URL=

# Логин и пароль пользователя 1С с необходимыми правами для API —
# подтверждено поддержкой 1С, что авторизация именно такая (HTTP Basic
# Auth), а не отдельный технический API-ключ.
FITNESS1C_LOGIN=
FITNESS1C_PASSWORD=
FITNESS1C_APIKEY=
FITNESS1C_CLUB_ID=