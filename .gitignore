# Переменные окружения и секреты — НИКОГДА не в Git.
# Реальные значения FITNESS1C_LOGIN / FITNESS1C_PASSWORD, SECRET_KEY и
# любых других паролей/ключей задаются в .env ЛОКАЛЬНО или в панели
# переменных окружения хостинга (Render → Environment), не здесь.
.env
.env.*
!.env.example

# Локальная база данных — содержит пароли клиентов/тренеров/админов
# (хешированные, но всё равно не для публичного репозитория) и может
# содержать реальные телефоны и персональные данные.
instance/
*.db
*.sqlite
*.sqlite3

# Служебные файлы Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# IDE/ОС
.DS_Store
.vscode/
.idea/
